<?xml version="1.0" encoding="utf-8"?>
<!-- Branded notification small icon: two mirrored leaves on a short stem,
     echoing the app logo's sprout silhouette. Must stay pure white with
     alpha only — Android tints notification small icons itself and will
     render any color information as solid white regardless. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Stem -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:pathData="M12,20 C12,17.5 12,15.5 12,13.5" />

    <!-- Right leaf -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,13.5 C12,10.8 14,8 18,6.5 C20,9.3 19.2,13 16.2,14.8 C14.5,15.8 12.6,15.3 12,13.5 Z" />

    <!-- Left leaf (mirrored) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,13.5 C12,10.8 10,8 6,6.5 C4,9.3 4.8,13 7.8,14.8 C9.5,15.8 11.4,15.3 12,13.5 Z" />
</vector>
