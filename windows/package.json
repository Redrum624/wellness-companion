{
  "name": "wellness-companion",
  "version": "1.3.1",
  "description": "Daily Wellness Companion — Desktop Analysis Hub",
  "main": "./out/main/index.js",
  "author": "Redrum624",
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:win": "electron-vite build && electron-builder --win --dir",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-rebuild -f -w better-sqlite3-multiple-ciphers",
    "test": "jest"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "12.11.1",
    "bonjour-service": "^1.3.0",
    "date-fns": "^4.1.0",
    "lucide-react": "1.31.0",
    "node-llama-cpp": "^3.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "uuid": "^11.0.5",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.41",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.wellnesscompanion.app",
    "productName": "Wellness Companion",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "resources/icon.png"
    }
  }
}
